# Copy to `.env` (git-ignored) and adjust. Never commit real values.
# The server loads this file from the repository root in development.

# ---- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Required. Point at your own MongoDB (local mongod, Atlas, ...).
MONGODB_URI=mongodb://localhost:27017/realtime_chat
# Comma-separated list of browser origins allowed by CORS and Socket.IO.
CLIENT_ORIGIN=http://localhost:5173
# Optional: error | warn | info | debug (defaults to info; silent under NODE_ENV=test)
LOG_LEVEL=info
# Optional: API rate limit per client IP (defaults: 300 requests / 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Authentication (consumed from Phase 1; not read by the server yet) -------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# ---- Client (Vite; values are embedded in the public JS bundle) --------------
# Optional. When unset the client uses same-origin `/api` and the Vite dev
# server proxies `/api` and `/socket.io` to the backend on PORT.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
