# Copy to `.env` (git-ignored) and adjust. Never commit real values.
# The server loads this file from the repository root in development.

# ---- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Required. Point at your own MongoDB (local mongod, Atlas, ...).
MONGODB_URI=mongodb://localhost:27017/realtime_chat
# Comma-separated list of browser origins allowed by CORS and Socket.IO.
# Must be https:// origins when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# Optional: error | warn | info | debug (defaults to info; silent under NODE_ENV=test)
LOG_LEVEL=info
# Optional: API rate limit per client IP (defaults: 300 requests / 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Number of reverse proxies in front of the server (0 = none: X-Forwarded-For
# is ignored). Set it to the exact hop count behind a proxy/load balancer so
# rate limits see the real client IP; never larger, or clients can spoof it.
TRUST_PROXY=0

# ---- Authentication -----------------------------------------------------------
# Required. At least 32 characters; the placeholder below is rejected at startup.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime / idle timeout. Active sessions are renewed (sliding) until
# SESSION_MAX_AGE after sign-in, after which the user must sign in again.
JWT_EXPIRES_IN=1h
SESSION_MAX_AGE=7d
# Cookie hardening. AUTH_COOKIE_SECURE defaults to true in production (where
# false is rejected) and false otherwise (http://localhost). SameSite=none
# requires AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Stricter limit for POST /api/auth/login (failed attempts) and
# /api/auth/register, per IP (defaults: 10 per 15 minutes).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- Socket.IO abuse protection (all per SOCKET_RATE_LIMIT_WINDOW_MS) ------
SOCKET_RATE_LIMIT_WINDOW_MS=10000
# new connections per client IP
SOCKET_CONNECTION_RATE_LIMIT=30
# events / message:send per socket
SOCKET_EVENT_RATE_LIMIT=120
SOCKET_MESSAGE_RATE_LIMIT=30
# invalid payloads or unknown events per socket before it is disconnected
SOCKET_INVALID_EVENT_LIMIT=20

# ---- Client (Vite; values are embedded in the public JS bundle) --------------
# Optional. When unset the client uses same-origin `/api` and the Vite dev
# server proxies `/api` and `/socket.io` to the backend on PORT.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
