# Reference only: the automated test suites do NOT read .env files.
#
# - Server integration/socket tests start an ephemeral in-memory MongoDB
#   (mongodb-memory-server) and inject its URI directly.
# - E2E tests (scripts/e2e-backend.js) do the same and set the variables below.
# - JWT_SECRET is generated randomly per run by the test harnesses; the value
#   below only illustrates the format.
# - The server refuses to start with NODE_ENV=test unless MONGODB_URI points
#   at a loopback host, so tests can never touch a shared/production database.

NODE_ENV=test
PORT=5100
MONGODB_URI=mongodb://127.0.0.1:27017/realtime_chat_test
CLIENT_ORIGIN=http://127.0.0.1:4173
LOG_LEVEL=error
JWT_SECRET=test-only-placeholder-not-a-real-secret-0000000000
JWT_EXPIRES_IN=1h
SESSION_MAX_AGE=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_MAX=10000
RATE_LIMIT_MAX=10000
VITE_API_URL=http://127.0.0.1:5100/api
VITE_SOCKET_URL=http://127.0.0.1:5100
